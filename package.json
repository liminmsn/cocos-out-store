{
  "name": "cocos-store-build",
  "version": "1.0.0",
  "description": "Cocos Creator3.x构建输出商城发布包cli",
  "type": "module",
  "bin": {
    "cocos-build": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "ora": "^9.4.1"
  }
}
